pipeline {
    agent any

    environment {
        // --- MODIFIED for 'logiq' repository ---
        REPO_NAME = 'logiq' // Set repository name
        BRANCH = 'production'
        GITHUB_CREDENTIALS = 'trench-github' // Use the GitHub App credential ID
        GITHUB_ORG_OR_USER = 'trench-security' // Your GitHub Organization
        GITHUB_REPO_URL = "https://github.com/${GITHUB_ORG_OR_USER}/${REPO_NAME}.git" // HTTPS URL
        // --- END MODIFIED ---

        // --- Kept GCP/Kube settings ---
        GOOGLE_APPLICATION_CREDENTIALS = '/var/lib/jenkins/trench-kube-access.json'
        KUBE_CONTEXT = 'gke_trench-production_us-central1-b_trench-prod'
        CLUSTER_NAME = 'trench-prod'
        CLUSTER_ZONE = 'us-central1-b'
        GCP_PROJECT_NAME = 'trench-production'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "Checking out ${BRANCH} from ${GITHUB_REPO_URL}"
                    // --- MODIFIED: Use GitHub App credentials and HTTPS URL ---
                    checkout scm: [
                        $class: 'GitSCM',
                        branches: [[name: "*/${BRANCH}"]],
                        userRemoteConfigs: [[
                            credentialsId: "${GITHUB_CREDENTIALS}", // Use the GitHub App credential ID
                            url: "${GITHUB_REPO_URL}"              // Use the HTTPS URL
                        ]],
                        // Explicitly ensure tags are fetched
                        extensions: [[$class: 'CloneOption', tags: true]]
                    ]
                    // --- END MODIFIED ---
                }
            }
        }

        stage('Check Git Tag') {
            steps {
                script {
                    // --- MODIFIED: Removed sshagent and explicit fetch ---
                    echo "Describing latest tag reachable from HEAD on branch ${BRANCH}..."
                    def latestTag = sh(script: "git describe --tags --abbrev=0 HEAD", returnStdout: true).trim()
                    if (!latestTag) {
                        error "No Git tag found reachable from the current commit (HEAD) on branch ${BRANCH}. Ensure the commit merged to production has been tagged."
                    }

                    echo "Reading version from version.py..."
                    if (!fileExists('version.py')) {
                         error "version.py not found in the workspace root."
                    }
                    // Assuming same format as watcher/sense
                    def versionFromFile = readFile('version.py').split('=')[1].trim().replace('"', '').trim()

                    echo "Comparing Git tag (${latestTag}) with version.py (${versionFromFile})"
                    if (latestTag != versionFromFile) {
                        error "Tag mismatch error: Latest reachable Git tag (${latestTag}) does not match version in version.py (${versionFromFile})"
                    } else {
                        echo "Tag matches: ${latestTag}"
                    }

                    env.DOCKER_TAG = latestTag
                    // --- END MODIFIED ---
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    if (!env.DOCKER_TAG) {
                        error "DOCKER_TAG environment variable not set. Cannot build Docker image."
                    }
                    echo "Building Docker image with tag: ${DOCKER_TAG}"
                    def dockerfilePath = "deployment/Dockerfile"
                     if (!fileExists(dockerfilePath)) {
                         error "${dockerfilePath} not found in the workspace."
                    }
                    sh "docker build -t gcr.io/${GCP_PROJECT_NAME}/docker-repo/${REPO_NAME}:${DOCKER_TAG} -f ${dockerfilePath} ."
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    if (!env.DOCKER_TAG) {
                        error "DOCKER_TAG environment variable not set. Cannot push Docker image."
                    }
                    echo 'Authenticating to Google Cloud...'
                    sh "gcloud auth activate-service-account --key-file=${GOOGLE_APPLICATION_CREDENTIALS}"
                    echo 'Configuring Docker to use gcloud credentials...'
                    sh 'gcloud auth configure-docker gcr.io --quiet' // Added --quiet
                    echo "Pushing Docker image gcr.io/${GCP_PROJECT_NAME}/docker-repo/${REPO_NAME}:${DOCKER_TAG} to GCR..."
                    sh "docker push gcr.io/${GCP_PROJECT_NAME}/docker-repo/${REPO_NAME}:${DOCKER_TAG}"
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                     if (!env.DOCKER_TAG) {
                        error "DOCKER_TAG environment variable not set. Cannot deploy."
                    }
                    echo 'Authenticating to the Kubernetes cluster...'
                    sh "gcloud auth activate-service-account --key-file=${GOOGLE_APPLICATION_CREDENTIALS}"
                    echo 'Fetching Kubernetes cluster credentials...'
                    sh "gcloud container clusters get-credentials ${CLUSTER_NAME} --zone ${CLUSTER_ZONE} --project ${GCP_PROJECT_NAME}"

                    // --- Deploy Main Application ---
                    def deploymentFile = "deployment/${REPO_NAME}.yaml"
                     if (!fileExists(deploymentFile)) {
                         error "${deploymentFile} not found in the workspace."
                    }
                    echo "Replacing <BUILD_TAG> in ${deploymentFile} with actual Docker tag ${DOCKER_TAG}..."
                    sh "sed -i 's|<BUILD_TAG>|${DOCKER_TAG}|g' ${deploymentFile}"
                    echo "Deploying the application ${deploymentFile} to Kubernetes context ${KUBE_CONTEXT}..."
                    sh "kubectl apply -f ${deploymentFile} --context ${KUBE_CONTEXT}" // Added context

                    // --- Deploy Service (Specific to logiq) ---
                    def serviceFile = "deployment/${REPO_NAME}-service.yaml"
                     if (!fileExists(serviceFile)) {
                         error "${serviceFile} not found in the workspace."
                    }
                    echo "Setting up the service ${serviceFile} for module..."
                    sh "kubectl apply -f ${serviceFile} --context ${KUBE_CONTEXT}" // Added context
                }
            }
        }
    }
     post {
         always {
             echo 'Pipeline finished.'
             // cleanWs()
         }
         success {
             echo "Pipeline successfully deployed version ${env.DOCKER_TAG}"
         }
         failure {
             echo "Pipeline failed. Check logs for details."
         }
     }
}